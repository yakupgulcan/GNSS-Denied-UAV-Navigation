      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://map_original/meshes/map_original.glb</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://map_original/meshes/map_original_ground.glb</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </collision>
    </link>
